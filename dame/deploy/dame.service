# systemd unit for running Dame without Docker.
# Copy ~/spieleabend/dame to /opt/dame, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/dame/deploy/dame.service /etc/systemd/system/
#   sudo systemctl enable --now dame
[Unit]
Description=Dame game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/dame
ExecStart=/usr/bin/node server.js
Environment=PORT=8094
Environment=DATA_DIR=/var/lib/dame
StateDirectory=dame
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
