# systemd unit for running Monopoly without Docker.
# Copy ~/spieleabend/monopoly to /opt/monopoly, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/monopoly/deploy/monopoly.service /etc/systemd/system/
#   sudo systemctl enable --now monopoly
[Unit]
Description=Monopoly game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/monopoly
ExecStart=/usr/bin/node server.js
Environment=PORT=8092
Environment=DATA_DIR=/var/lib/monopoly
StateDirectory=monopoly
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
