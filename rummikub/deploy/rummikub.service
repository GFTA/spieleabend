# systemd unit for running Rummikub without Docker.
# Copy ~/spieleabend/rummikub to /opt/rummikub, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/rummikub/deploy/rummikub.service /etc/systemd/system/
#   sudo systemctl enable --now rummikub
[Unit]
Description=Rummikub game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/rummikub
ExecStart=/usr/bin/node server.js
Environment=PORT=8098
Environment=DATA_DIR=/var/lib/rummikub
StateDirectory=rummikub
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
