# systemd unit for running Machi Koro without Docker.
# Copy ~/spieleabend/machikoro to /opt/machikoro, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/machikoro/deploy/machikoro.service /etc/systemd/system/
#   sudo systemctl enable --now machikoro
[Unit]
Description=Machi Koro game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/machikoro
ExecStart=/usr/bin/node server.js
Environment=PORT=8091
Environment=DATA_DIR=/var/lib/machikoro
StateDirectory=machikoro
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
