# systemd unit for running Sudoku without Docker.
# Copy ~/spieleabend/sudoku to /opt/sudoku, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/sudoku/deploy/sudoku.service /etc/systemd/system/
#   sudo systemctl enable --now sudoku
[Unit]
Description=Sudoku game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/sudoku
ExecStart=/usr/bin/node server.js
Environment=PORT=8089
Environment=DATA_DIR=/var/lib/sudoku
StateDirectory=sudoku
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
