# systemd unit for running Carcassonne without Docker.
# Copy ~/spieleabend/carcassonne to /opt/carcassonne, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/carcassonne/deploy/carcassonne.service /etc/systemd/system/
#   sudo systemctl enable --now carcassonne
[Unit]
Description=Carcassonne game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/carcassonne
ExecStart=/usr/bin/node server.js
Environment=PORT=8091
Environment=DATA_DIR=/var/lib/carcassonne
StateDirectory=carcassonne
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
