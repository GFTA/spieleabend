# systemd unit for running Activity without Docker.
# Copy ~/spieleabend/activity to /opt/activity, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/activity/deploy/activity.service /etc/systemd/system/
#   sudo systemctl enable --now activity
[Unit]
Description=Activity game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/activity
ExecStart=/usr/bin/node server.js
Environment=PORT=8100
Environment=DATA_DIR=/var/lib/activity
StateDirectory=activity
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
