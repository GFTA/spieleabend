# systemd unit for running Phase 10 without Docker.
# Copy ~/spieleabend/phase10 to /opt/phase10, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/phase10/deploy/phase10.service /etc/systemd/system/
#   sudo systemctl enable --now phase10
[Unit]
Description=Phase 10 game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/phase10
ExecStart=/usr/bin/node server.js
Environment=PORT=8086
Environment=DATA_DIR=/var/lib/phase10
StateDirectory=phase10
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
