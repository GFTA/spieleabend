# systemd unit for running Würfelpoker without Docker.
# Copy the uno/ folder to /opt/wuerfelpoker, run `npm ci --omit=dev` there, then:
#   sudo cp deploy/wuerfelpoker.service /etc/systemd/system/
#   sudo systemctl enable --now wuerfelpoker
[Unit]
Description=Würfelpoker game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/wuerfelpoker
ExecStart=/usr/bin/node server.js
Environment=PORT=8083
Environment=DATA_DIR=/var/lib/wuerfelpoker
StateDirectory=wuerfelpoker
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
