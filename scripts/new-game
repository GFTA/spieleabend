#!/bin/sh
# Wrapper: uses node if installed, otherwise a throwaway node container (the host may have no node).
d=$(cd "$(dirname "$0")" && pwd)
if command -v node >/dev/null 2>&1; then exec node "$d/new-game.js" "$@"; fi
exec docker run --rm --user "$(id -u):$(id -g)" -v "$d/..:/w" -w /w node:22-alpine node scripts/new-game.js --repo /w "$@"
