# systemd unit for running Galgenmännchen without Docker.
# Copy ~/spieleabend/hangman to /opt/hangman, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/hangman/deploy/hangman.service /etc/systemd/system/
#   sudo systemctl enable --now hangman
[Unit]
Description=Galgenmännchen game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/hangman
ExecStart=/usr/bin/node server.js
Environment=PORT=8085
Environment=DATA_DIR=/var/lib/hangman
StateDirectory=hangman
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
