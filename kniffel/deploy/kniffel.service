# systemd unit for running Kniffel without Docker.
# Copy the uno/ folder to /opt/kniffel, run `npm ci --omit=dev` there, then:
#   sudo cp deploy/kniffel.service /etc/systemd/system/
#   sudo systemctl enable --now kniffel
[Unit]
Description=Kniffel game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/kniffel
ExecStart=/usr/bin/node server.js
Environment=PORT=8087
Environment=DATA_DIR=/var/lib/kniffel
StateDirectory=kniffel
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
