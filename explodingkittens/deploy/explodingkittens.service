# systemd unit for running Exploding Kittens without Docker.
# Copy ~/spieleabend/explodingkittens to /opt/explodingkittens, run `npm ci --omit=dev` there, then:
#   sudo cp ~/spieleabend/explodingkittens/deploy/explodingkittens.service /etc/systemd/system/
#   sudo systemctl enable --now explodingkittens
[Unit]
Description=Exploding Kittens game server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/explodingkittens
ExecStart=/usr/bin/node server.js
Environment=PORT=8096
Environment=DATA_DIR=/var/lib/explodingkittens
StateDirectory=explodingkittens
DynamicUser=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
